rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /player-photos/{photo} {
      // Anyone can read avatars (needed for public match pages)
      allow read: if true;
      // Only authenticated users can upload
      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024     // 200 KB max
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
