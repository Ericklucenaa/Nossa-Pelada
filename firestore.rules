rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public match documents — readable by anyone (WhatsApp join links),
    // creatable/deletable only by authenticated users,
    // updatable by anyone with the link (guests RSVP without an account)
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if true;
    }

    // Per-user app state — only the owner can read/write
    match /user_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username → email mapping used during login/register
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
